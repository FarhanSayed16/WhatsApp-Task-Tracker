# ═════════════════════════════════════════════════════════════
# WhatsApp Task Tracker — Environment Variables
# ═════════════════════════════════════════════════════════════

# Supabase (Server-side only — NEVER expose service role key to client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Auth & Sessions (Used by jose for signing 30-day JWT cookies)
SESSION_SECRET=your-random-32-character-or-longer-secret-key-here

# Cron Security (Protects keepalive route against unauthorized triggers)
CRON_SECRET=your-random-cron-secret-here

# Base URL for generating public task links
# Local:
APP_URL=http://localhost:3000
# Vercel (use your real https://….vercel.app URL — never localhost):
# APP_URL=https://whats-app-task-tracker.vercel.app
# NEXT_PUBLIC_APP_URL=https://whats-app-task-tracker.vercel.app

# Dev-only auth bypass (PIN 123456 without DB). NEVER set on Vercel.
# ALLOW_DEV_AUTH=true

# Do not set PORT on Vercel. Import `.env.vercel` (gitignored) for production vars.

# Optional Features
# RESEND_API_KEY=re_your_resend_api_key_here          # Phase 13 (Email digests)
# RESEND_FROM_EMAIL="WhatsApp Task Tracker <onboarding@resend.dev>"
# GEMINI_API_KEY=your-google-gemini-api-key-here      # Phase 15 (AI task parsing)
