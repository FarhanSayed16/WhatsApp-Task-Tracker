# ═════════════════════════════════════════════════════════════
# WhatsApp Task Tracker — Environment Variables
# ═════════════════════════════════════════════════════════════

# Supabase (Server-side only — NEVER expose service role key to client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Auth & Sessions (Used by jose for signing 30-day JWT cookies)
SESSION_SECRET=your-random-32-character-or-longer-secret-key-here

# Cron Security (Protects keepalive route against unauthorized triggers)
CRON_SECRET=your-random-cron-secret-here

# Base URL for generating public task links
APP_URL=http://localhost:3000

# Optional Features
# RESEND_API_KEY=re_your_resend_api_key_here          # Phase 13 (Email digests)
# GEMINI_API_KEY=your-google-gemini-api-key-here      # Phase 15 (AI task parsing)
